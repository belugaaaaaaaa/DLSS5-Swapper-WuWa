{
  "name": "dlss5-swapper-wuwa",
  "version": "2.2.7",
  "description": "DLSS 5 (Neural Rendering) for your games - a library that finds them, and one click to install",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:ui": "electron scripts/test-game-filters-ui.js",
    "test:payload": "node scripts/test-feeder-payload.js",
    "test:optiscaler": "node scripts/test-optiscaler-payload.js",
    "payload": "node scripts/import-official-payload.js",
    "build": "node scripts/build-portable.js",
    "build:linux": "electron-builder --linux AppImage deb",
    "icon": "electron scripts/make-icon.js",
    "build:portable": "node scripts/build-portable.js",
    "overlay:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-overlay.ps1",
    "overlay:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-overlay.ps1",
    "test:wuwa": "node --test --test-concurrency=1 test/wuwa-install-ipc.test.js test/overlay-idle.test.js",
    "payload:upstream": "node scripts/collect-payload.js",
    "wuwa:stage": "node scripts/stage-package.js",
    "wuwa:build": "node scripts/build-portable.js",
    "wuwa:verify": "node scripts/verify-package.js"
  },
  "author": "Rakan Alkhaldi",
  "license": "MIT",
  "dependencies": {
    "extract-zip": "^2.0.1"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8",
    "@electron/asar": "3.4.1"
  },
  "build": {
    "appId": "io.github.belugaaaaaaaa.dlss5swapper.wuwa",
    "productName": "DLSS 5 Swapper WuWa",
    "files": [
      "main.js",
      "preload.js",
      "overlay-preload.js",
      "THIRD_PARTY_NOTICES.md",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "maintainer": "Rakan Alkhaldi",
      "icon": "app_iocn.png",
      "artifactName": "DLSS5-Swapper-${version}-${arch}.${ext}"
    },
    "compression": "maximum",
    "portable": {
      "artifactName": "DLSS5-Swapper-2.2.7-wuwa-${arch}.exe",
      "unpackDirName": "DLSS5-Swapper-WuWa"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "DLSS 5 Swapper WuWa",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": true,
      "artifactName": "DLSS5-Swapper-Setup-${version}.exe",
      "include": "build/installer.nsh"
    }
  }
}
